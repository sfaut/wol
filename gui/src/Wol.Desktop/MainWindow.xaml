<?xml version="1.0" encoding="utf-8"?>
<!--
    Main window (design/specs/layout.md, "Window and navigation"): title bar with the pane
    toggle, navigation by group, machine list.
-->
<Window
    x:Class="Wol.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Wol.Desktop.Views">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            Height="40"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested" />

        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            CompactModeThresholdWidth="641"
            ExpandedModeThresholdWidth="960"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            OpenPaneLength="280"
            PaneDisplayMode="Auto"
            ItemInvoked="Navigation_ItemInvoked"
            SelectionChanged="Navigation_SelectionChanged">
            <Grid>
                <views:MachineListPage x:Name="ListPage" />
                <views:SettingsPage x:Name="SettingsView" Visibility="Collapsed" />
            </Grid>
        </NavigationView>

        <!-- Where a dragged group would land (navigation pane or machine list). -->
        <Canvas x:Name="DropLayer" Grid.Row="1" IsHitTestVisible="False">
            <Rectangle
                x:Name="DropMarker"
                Height="2"
                Fill="{ThemeResource AccentFillColorDefaultBrush}"
                RadiusX="1"
                RadiusY="1"
                Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
