<?xml version="1.0" encoding="utf-8"?>
<!--
    State indicator (design/specs/states.md): an outer glyph in the state colour with an inner
    mark, or a ProgressRing while waking. Decorative: the row's automation name carries the state.
-->
<UserControl
    x:Class="Wol.Desktop.Controls.StateIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="16"
    Height="16"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">
    <Grid>
        <Grid x:Name="OnlineIcon" Visibility="Collapsed">
            <FontIcon FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xF136;" />
            <FontIcon FontSize="16" Foreground="{ThemeResource TextFillColorInverseBrush}" Glyph="&#xF13E;" />
        </Grid>
        <FontIcon
            x:Name="OfflineIcon"
            FontSize="16"
            Foreground="{ThemeResource SystemFillColorSolidNeutralBrush}"
            Glyph="&#xF138;"
            Visibility="Collapsed" />
        <ProgressRing
            x:Name="WakingIcon"
            Width="16"
            Height="16"
            MinWidth="16"
            MinHeight="16"
            IsActive="False"
            IsIndeterminate="True"
            Visibility="Collapsed" />
        <Grid x:Name="TimedOutIcon" Visibility="Collapsed">
            <FontIcon FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xF139;" />
            <FontIcon FontSize="16" Foreground="{ThemeResource TextFillColorInverseBrush}" Glyph="&#xF13B;" />
        </Grid>
        <Grid x:Name="UnknownIcon">
            <FontIcon FontSize="16" Foreground="{ThemeResource SystemFillColorSolidNeutralBrush}" Glyph="&#xF136;" />
            <FontIcon FontSize="16" Foreground="{ThemeResource TextFillColorInverseBrush}" Glyph="&#xF142;" />
        </Grid>
        <Grid x:Name="ErrorIcon" Visibility="Collapsed">
            <FontIcon FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xF136;" />
            <FontIcon FontSize="16" Foreground="{ThemeResource TextFillColorInverseBrush}" Glyph="&#xF13D;" />
        </Grid>
    </Grid>
</UserControl>
