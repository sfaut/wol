<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Wol.Desktop</RootNamespace>
    <AssemblyName>wol-gui</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>en-US</DefaultLanguage>

    <!-- WinUI 3, unpackaged (no MSIX), Windows App SDK bundled next to the executable. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- MSIX tooling also publishes the app resources index (wol-gui.pri), needed by XAML. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Portable folder: .NET runtime compiled into the executable. -->
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>

    <!-- LibraryImport (Win32 calls) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Program.cs is the entry point (single instance), not the one generated from App.xaml. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <Version>0.1.0</Version>
    <ApplicationIcon>Assets/wol-gui.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icons built by tools/Build-Icons.ps1 from design/assets. -->
    <Content Include="Assets/*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Windows App SDK components the app uses, rather than the Microsoft.WindowsAppSDK
      metapackage: it would also ship the AI, ML, search and widgets runtimes (~60 MB).
      InteractiveExperiences is pinned because WinUI asks for a version that is not published.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <!--
    The GUI runs wol.exe from its own folder. During development, copy the CLI built in
    cli/target: the release build when present, the debug build otherwise.
  -->
  <PropertyGroup>
    <CliTarget>$(MSBuildThisFileDirectory)..\..\..\cli\target\</CliTarget>
    <CliExecutable Condition="Exists('$(CliTarget)release\wol.exe')">$(CliTarget)release\wol.exe</CliExecutable>
    <CliExecutable Condition="'$(CliExecutable)' == '' And Exists('$(CliTarget)debug\wol.exe')">$(CliTarget)debug\wol.exe</CliExecutable>
  </PropertyGroup>
  <ItemGroup Condition="'$(CliExecutable)' != ''">
    <None Include="$(CliExecutable)" Link="wol.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
